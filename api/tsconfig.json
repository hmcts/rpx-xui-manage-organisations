{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "../dist/rpx-xui-manage-organisations/api",
    "target": "es2022",
    "esModuleInterop": true,
    "types": [
      "node",
      "mocha",
      "rxjs"
    ],
    "lib": [
      "es2022",
      "dom"
    ],
    "module": "commonjs",
    "moduleResolution": "bundler",
    "strict": false,
    "rootDir": ".."
  },
  "include": [
    "**/*.ts",
    "../*.ts"
  ],
  "exclude": [
    "**/*.spec.ts"
  ],
  "files": [
    "./customTypings/customExpress/index.d.ts"
  ]
}
