{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": false,
    "module": "es2022",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2022",
    "importHelpers": true,
    "skipLibCheck": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2022",
      "dom"
    ],
    "paths": {
      "hmcts-form-builder": [
        "./dist/hmcts-form-builder"
      ],
      "hmcts-form-builder/*": [
        "./dist/hmcts-form-builder/*"
      ],
      "gov-ui": [
        "./dist/gov-ui"
      ],
      "gov-ui/*": [
        "./dist/gov-ui/*"
      ],
      "src/*": [
        "./src/*"
      ],
      "projects/*": [
        "./projects/*"
      ]
    },
    "useDefineForClassFields": false,
    "strict": false,
    "rootDir": "."
  },
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "bundler"
    }
  }
}
